<service>
  <id>OceanCurse</id>
  <name>Ocean Curse</name>
  <description>Ocean Curse Discord bot</description>

  <executable>C:\ProgramData\OceanCurse\runtime\node-v22.14.0-win-x64\node.exe</executable>
  <arguments>dist\index.js</arguments>
  <workingdirectory>C:\ProgramData\OceanCurse\app</workingdirectory>

  <env name="OCEAN_CURSE_ENV_FILE" value="C:\ProgramData\OceanCurse\secrets\oceancurse.env" />
  <env name="STATE_PATH" value="C:\ProgramData\OceanCurse\state\state.json" />
  <env name="HEALTH_FILE" value="C:\ProgramData\OceanCurse\state\ready" />
  <env name="YT_DLP_PATH" value="C:\ProgramData\OceanCurse\bin\yt-dlp.exe" />
  <env name="CURSE_TTL_MINUTES" value="10080" />

  <startmode>Automatic</startmode>
  <delayedAutoStart />
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>NetworkService</user>
  </serviceaccount>

  <onfailure action="restart" delay="10 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>15 sec</stoptimeout>

  <logpath>C:\ProgramData\OceanCurse\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
